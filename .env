# ============================================================
#  Telegram (optional - leave empty to disable)
# ============================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============================================================
#  Server binding
# ============================================================
# 127.0.0.1 = localhost only (local testing)
# 0.0.0.0   = all interfaces (LAN access, clicker on another machine)
HOST=127.0.0.1
PORT=5000
HEALTH_DETAIL=1 

# ============================================================
#  CORS (comma-separated origins)
# ============================================================
ALLOWED_ORIGINS=http://127.0.0.1:5000,http://localhost:5000

# ============================================================
#  WebSocket security (recommended for production)
# ============================================================
# Generate with: openssl rand -hex 32
# Leave empty to disable auth (local testing only)
# WS_AUTH_TOKEN=

# ============================================================
#  Performance tuning (optional - defaults shown)
# ============================================================
# STATE_MIN_INTERVAL_MS=120
# BROADCAST_CHUNK=2000
# WS_IDLE_TIMEOUT_S=120
# WS_BINARY=1
# REST_TIMEOUT_S=
STATE_MIN_INTERVAL_MS=60

# ── Proxy (শুধু দরকার হলে) ────────────────────────────────
